---
/* A full-bleed plate on the ember field between two paper sections: a breath in
   the file, with its caption set on the plate. */
import Halftone from './Halftone.astro';
import type { ImageId } from '../data/images.generated';
interface Props {
    id: ImageId;
    /** Caption; `*Title*` is set as a citation. */
    caption: string;
}
const { id, caption } = Astro.props;
import { cite } from '../lib/cite';
---

<figure class="band">
    <Halftone id={id} tone="ember" drift sizes="100vw" />
    <figcaption class="page">
        <span class="caption band__caption" set:html={cite(caption)} />
    </figcaption>
</figure>

<style>
    .band {
        --caption: var(--amber-soft);
        position: relative;
        z-index: 2;
        margin: 0;
        background: var(--ember);
        padding-bottom: var(--space-5);
    }
    .band :global(.halftone) {
        aspect-ratio: auto;
        width: 100%;
        height: min(70vh, 42vw);
    }
    .band figcaption {
        padding-top: var(--space-3);
    }
</style>
