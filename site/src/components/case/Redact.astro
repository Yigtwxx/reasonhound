---
/* A secret as the model sees it: a black bar in the file, the redaction label
   underneath. Hover or focus lifts the bar to show what the egress redactor
   wrote in its place — never the secret itself, which the page does not have.
   When the file scrolls into view the bars are laid down one after another, a
   marker pass over each value: egress-redactor at work before anything leaves. */
interface Props {
    /** The label egress-redactor writes, e.g. "jwt" → [REDACTED:jwt]. */
    label: string;
    /** Width of the bar, in characters of the hidden value. */
    chars?: number;
}
const { label, chars = 18 } = Astro.props;
---

<span class="redact" tabindex="0" style={`--chars: ${chars}`}>
    <span class="redact__label">[REDACTED:{label}]</span>
    <span class="redact__bar" aria-hidden="true"></span>
</span>

<style>
    .redact {
        position: relative;
        display: inline-grid;
        vertical-align: baseline;
        font-family: var(--font-mono);
        font-size: 0.9em;
        min-width: calc(var(--chars) * 1ch);
        border-radius: 1px;
        cursor: help;
    }
    .redact__label {
        grid-area: 1 / 1;
        color: var(--ember);
        white-space: nowrap;
        padding-inline: 0.2em;
    }
    .redact__bar {
        grid-area: 1 / 1;
        background: var(--ink);
        transform-origin: left center;
        transition: transform 360ms var(--ease-pen);
        /* a marker stroke, slightly uneven at the ends */
        clip-path: polygon(0 8%, 100% 0, 99% 94%, 1% 100%);
    }
    .redact:hover .redact__bar,
    .redact:focus-visible .redact__bar {
        transform: scaleX(0.04);
    }
    /* Only hidden under html.js with motion allowed, so a failed script or a
       reader who asked for less motion sees every bar already in place. */
    @media (prefers-reduced-motion: no-preference) {
        :global(html.js) .redact:not(.is-marked) .redact__bar {
            transform: scaleX(0);
            transition: none;
        }
        .redact.is-marked .redact__bar {
            transition: transform 520ms var(--ease-pen) var(--mark-delay, 0ms);
        }
        .redact.is-marked:hover .redact__bar,
        .redact.is-marked:focus-visible .redact__bar {
            transition-delay: 0ms;
        }
    }
</style>

<script>
    const PASS_MS = 260;
    const bars = Array.from(document.querySelectorAll<HTMLElement>('.redact'));
    const mark = (el: HTMLElement): void => {
        const group = el.parentElement?.closest('[aria-label]') ?? document.body;
        const index = Array.from(group.querySelectorAll('.redact')).indexOf(el);
        el.style.setProperty('--mark-delay', `${240 + Math.max(0, index) * PASS_MS}ms`);
        el.classList.add('is-marked');
    };
    if (!('IntersectionObserver' in window)) {
        bars.forEach(mark);
    } else {
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    mark(entry.target as HTMLElement);
                    observer.unobserve(entry.target);
                }
            },
            { threshold: 1, rootMargin: '0px 0px -15% 0px' },
        );
        bars.forEach((b) => observer.observe(b));
    }
</script>
