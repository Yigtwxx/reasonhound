---
/* The pack: every agent by name, grouped as the lead dispatches them, with the
   toolkit each one is limited to. The Ridinger plate is the picture for it: one
   huntsman, one horn, many noses.

   When the roster scrolls into view the lead dispatches the demo hunt's pack
   (the agents the four beats name, in the order the beats call them): each
   name is marked off like a clerk working down a duty roster, then the agents
   left unmarked settle back, the rest of the kennel. */
import { packs, agentCount } from '../data/agents';
import { beats } from '../data/loop';
import Halftone from './Halftone.astro';
import SketchArrow from './sketch/SketchArrow.astro';

// The lead is marked first: it is the one that dispatches the rest.
const leads = packs.find((g) => g.id === 'lead')?.agents.map((a) => a.name) ?? [];
const dispatched = [...new Set([...leads, ...beats.flatMap((b) => b.agents)])];
---

<div class="pack" data-pack style={`--woken: ${dispatched.length}`}>
    <figure class="pack__figure">
        <Halftone id="par-force" tone="paper" drift sizes="(min-width: 64rem) 30vw, 92vw" />
        <figcaption class="caption pack__caption">
            Johann Elias Ridinger, <cite>Huntsman with a Pack of Hounds</cite>. One horn, many
            noses.
        </figcaption>
        <div class="pack__aside">
            <SketchArrow direction="curve-right" size={52} />
            <p class="marginalia">
                {agentCount} agents. A typical scan wakes 8 to 14 of them; the rest stay in the
                kennel.
            </p>
        </div>
    </figure>
    <div class="pack__groups">
        {packs.map((group) => (
            <section
                class:list={['pack__group', `pack__group--${group.id}`]}
                aria-labelledby={`pack-${group.id}`}
            >
                <header class="pack__head">
                    <h3 id={`pack-${group.id}`} class="pack__title">
                        {group.title}
                        <span class="pack__count">{group.agents.length}</span>
                    </h3>
                    <p class="pack__note">{group.note}</p>
                </header>
                <ul class="pack__list" id={`pack-list-${group.id}`}>
                    {group.agents.map((a) => (
                        <li
                            class="pack__agent"
                            data-woken={dispatched.includes(a.name) ? '' : undefined}
                            style={
                                dispatched.includes(a.name)
                                    ? `--wake: ${dispatched.indexOf(a.name)}`
                                    : undefined
                            }
                        >
                            <code class="pack__name">{a.name}</code>
                            <span class="pack__role">{a.role}</span>
                            <span class="pack__kit">{a.kit}</span>
                        </li>
                    ))}
                </ul>
            </section>
        ))}
        <p class="pack__restricted">
            <b>Seven more are restricted.</b> Off by default; enabled one by one with{' '}
            <code>--enable-agent</code>, behind <code>--aggressive</code> and an interactive
            confirmation no flag can skip. Every action they take is written to{' '}
            <code>audit.log</code>.
        </p>
    </div>
</div>

<style>
    .pack {
        display: grid;
        gap: var(--space-7);
    }
    @media (min-width: 64rem) {
        .pack {
            grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
            gap: var(--space-7);
            align-items: start;
        }
        .pack__figure {
            position: sticky;
            top: 5rem;
        }
    }
    .pack__figure {
        margin: 0;
        max-width: 26rem;
    }
    .pack__caption {
        margin-top: var(--space-3);
    }
    .pack__aside {
        display: flex;
        gap: var(--space-2);
        align-items: flex-start;
        margin-top: var(--space-5);
    }
    .pack__aside :global(svg) {
        flex: none;
    }
    .pack__aside .marginalia {
        margin: 0;
    }
    .pack__groups {
        display: grid;
        gap: var(--space-6) var(--space-6);
    }
    @media (min-width: 48rem) {
        .pack__groups {
            grid-template-columns: 1fr 1fr;
        }
        .pack__group--lead {
            grid-column: 1 / -1;
        }
        .pack__group--hunters {
            grid-row: span 2;
        }
    }
    .pack__group {
        border-top: 2px solid var(--ink);
        padding-top: var(--space-3);
    }
    .pack__group--lead {
        border-top-color: var(--ember);
    }
    .pack__head {
        margin-bottom: var(--space-3);
    }
    .pack__title {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        font-size: var(--step-2);
        margin: 0 0 var(--space-1);
    }
    .pack__count {
        font-family: var(--font-type);
        font-size: var(--step-0);
        color: var(--ember);
    }
    .pack__note {
        font-family: var(--font-type);
        font-size: var(--step--1);
        color: var(--ink-mute);
        margin: 0;
    }
    .pack__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
    }
    .pack__agent {
        display: grid;
        gap: 0.1em;
        padding-block: var(--space-2);
        border-bottom: 1px dashed var(--paper-line);
    }
    .pack__name {
        justify-self: start;
        font-size: var(--step--1);
        font-weight: 500;
        background: none;
        padding: 0;
        color: var(--ink);
    }
    .pack__group--lead .pack__name {
        color: var(--ember);
    }
    .pack__role {
        font-size: var(--step--1);
        color: var(--ink-soft);
        line-height: 1.4;
    }
    .pack__kit {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--ink-mute);
    }
    /* The dispatch. Before it runs (html.js, motion allowed) nothing looks
       different, so a page without the script loses nothing. */
    @media (prefers-reduced-motion: no-preference) {
        .pack__name {
            background-image: linear-gradient(var(--amber-wash), var(--amber-wash));
            background-repeat: no-repeat;
            background-position: 0 85%;
            background-size: 0% 0.72em;
        }
        /* The lead's name is ember, so its mark is a warmer amber to show. */
        .pack__group--lead .pack__name {
            background-image: linear-gradient(
                color-mix(in srgb, var(--amber) 38%, transparent),
                color-mix(in srgb, var(--amber) 38%, transparent)
            );
        }
        .pack.is-dispatched [data-woken] .pack__name {
            background-size: 100% 0.72em;
            transition: background-size 360ms var(--ease-pen) calc(var(--wake) * 110ms);
        }
        /* The kennel settles to the muted ink: quieter, still AA on paper. */
        .pack__agent:not([data-woken]) :is(.pack__name, .pack__role) {
            transition: color 700ms ease calc(var(--woken) * 110ms + 250ms);
        }
        .pack.is-dispatched .pack__agent:not([data-woken]) :is(.pack__name, .pack__role) {
            color: var(--ink-mute);
        }
        /* Pointing at an agent wakes it. */
        .pack.is-dispatched .pack__agent:not([data-woken]):hover :is(.pack__name, .pack__role) {
            color: var(--ink);
            transition-delay: 0ms;
            transition-duration: 150ms;
        }
    }
    /* A phone: scripts below fold every group but the lead's into its heading,
       a button with the footer's own + caret. Title, count and note stay in
       view, so the roster still reads as a whole; the names open on demand. */
    :global(.pack__toggle) {
        appearance: none;
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
        width: 100%;
        padding: 0;
        border: 0;
        background: none;
        font: inherit;
        color: inherit;
        text-align: left;
        cursor: pointer;
    }
    :global(.pack__toggle) .pack__count {
        margin-left: auto;
    }
    :global(.pack__toggle::after) {
        content: '+';
        font-family: var(--font-mono);
        font-size: var(--step-0);
        color: var(--ember);
        transition: transform 160ms ease;
    }
    :global(.pack__toggle[aria-expanded='true']::after) {
        transform: rotate(45deg);
    }
    :global(.pack__toggle:focus-visible) {
        outline-offset: 4px;
    }
    .pack__group.is-folded .pack__list {
        display: none;
    }
    .pack__group.is-folded .pack__head {
        margin-bottom: 0;
    }
    .pack__restricted {
        grid-column: 1 / -1;
        font-size: var(--step--1);
        color: var(--ink-soft);
        max-width: 64ch;
        padding: var(--space-3) var(--space-4);
        border: 1px dashed var(--slate);
        margin: 0;
    }
</style>

<script>
    const pack = document.querySelector<HTMLElement>('[data-pack]');
    const roster = pack?.querySelector('.pack__groups');
    if (pack && roster && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
            (entries) => {
                if (!entries.some((e) => e.isIntersecting)) return;
                pack.classList.add('is-dispatched');
                observer.disconnect();
            },
            { rootMargin: '0px 0px -35% 0px' },
        );
        observer.observe(roster);
    }

    /* Folding on a phone. Each heading's contents move into a disclosure
       button and back out when the screen widens, so a wide screen and a page
       without script keep the plain headings and the whole roster open. */
    const narrow = window.matchMedia('(max-width: 47.99rem)');
    const groups = [
        ...document.querySelectorAll<HTMLElement>('.pack__group:not(.pack__group--lead)'),
    ];
    const fold = (on: boolean): void => {
        for (const group of groups) {
            const title = group.querySelector<HTMLElement>('.pack__title');
            const list = group.querySelector<HTMLElement>('.pack__list');
            if (!title || !list) continue;
            const toggle = title.querySelector<HTMLButtonElement>('.pack__toggle');
            if (on && !toggle) {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'pack__toggle';
                button.setAttribute('aria-expanded', 'false');
                button.setAttribute('aria-controls', list.id);
                button.append(...title.childNodes);
                button.addEventListener('click', () => {
                    const open = button.getAttribute('aria-expanded') !== 'true';
                    button.setAttribute('aria-expanded', String(open));
                    group.classList.toggle('is-folded', !open);
                });
                title.append(button);
                group.classList.add('is-folded');
            } else if (!on && toggle) {
                title.replaceChildren(...toggle.childNodes);
                group.classList.remove('is-folded');
            }
        }
    };
    fold(narrow.matches);
    narrow.addEventListener('change', (e) => fold(e.matches));
</script>
