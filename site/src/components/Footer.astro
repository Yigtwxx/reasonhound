---
/* Ember again: Tempesta's stag hunt in full cry as a band, then links, the sibling tools,
   and the credits every engraving on the page earned. Credits come from the
   image manifest. */
import { images } from '../data/images.generated';
import { repo, pypi, version, siblings } from '../data/commands';
import Halftone from './Halftone.astro';
const credits = Object.values(images).map((i) => i.credit);
const seen = new Set<string>();
const unique = credits.filter((c) => (seen.has(c.page_url) ? false : (seen.add(c.page_url), true)));
---

<footer class="footer" id="footer">
    <div class="footer__band" aria-hidden="true">
        <Halftone id="tempesta" tone="ember" hover={false} drift="--footer-plate" sizes="100vw" />
    </div>
    <div class="page footer__grid">
        <div class="footer__col">
            <p class="footer__name">
                reasonhound <span class="footer__version">v{version}</span>
            </p>
            <p class="footer__tag">Follows the scent. Not the checklist.</p>
            <ul class="footer__links">
                <li>
                    <a href={repo} rel="noopener">
                        GitHub
                    </a>
                </li>
                <li>
                    <a href={pypi} rel="noopener">
                        PyPI
                    </a>
                </li>
                <li>
                    <a href={`${repo}/blob/main/CHANGELOG.md`} rel="noopener">
                        Changelog
                    </a>
                </li>
                <li>
                    <a href={`${repo}/blob/main/LICENSE`} rel="noopener">
                        Licence
                    </a>
                </li>
            </ul>
            <div class="footer__family">
                <p class="footer__family-title">Same family</p>
                <ul>
                    {siblings.map((s) => (
                        <li>
                            <a href={s.href} rel="noopener">
                                {s.name}
                            </a>{' '}
                            <span>— {s.tag}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
        <details class="footer__col footer__credits">
            <summary class="footer__credits-title">Engravings on this page</summary>
            <ul>
                {unique.map((c) => (
                    <li>
                        <a href={c.page_url} rel="noopener">
                            {c.author}, <cite>{c.title}</cite>
                            {c.year ? `, ${c.year}` : ''}
                        </a>
                        <span class="footer__licence">
                            {' '}
                            — {c.source},{' '}
                            <a href={c.licence_url} rel="noopener">
                                {c.licence}
                            </a>
                        </span>
                    </li>
                ))}
            </ul>
            <p class="footer__note">
                Halftoned at build time from public-domain originals in the Rijksmuseum and the
                National Gallery of Art. The pencil lines, stamps and paw prints are drawn in SVG
                and CSS. No hound was harmed; several were engraved.
            </p>
        </details>
    </div>
</footer>

<style>
    .footer {
        /* The plate's drift timeline: the band clips the plate, so it
           drifts over the footer's pass instead of its own. The page ends before
           the footer can leave, so the drift spans its entry alone. */
        view-timeline: --footer-plate block;
        --drift-range: entry 0% entry 100%;
        --field: var(--ember);
        --pen: var(--amber-soft);
        --caption: var(--amber-soft);
        /* the height the plate shows bare before the wash starts */
        --band: min(46vh, 70vw);
        position: relative;
        isolation: isolate;
        background: var(--ember);
        color: var(--paper);
        padding-bottom: var(--space-7);
    }
    /* The plate runs under the whole footer; a translucent ember wash
       rises over it where the text sits, so the engraving still shows through. */
    .footer__band {
        position: absolute;
        inset: 0;
        z-index: -2;
        overflow: hidden;
    }
    .footer__band :global(.halftone) {
        aspect-ratio: auto;
        height: 100%;
    }
    .footer__band :global(img) {
        object-position: center 30%;
    }
    .footer::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(
            to bottom,
            transparent calc(var(--band) * 0.55),
            color-mix(in srgb, var(--ember) 82%, transparent) var(--band)
        );
    }
    .footer__grid {
        display: grid;
        gap: var(--space-6);
        padding-top: calc(var(--band) + var(--space-7));
    }
    @media (min-width: 48rem) {
        .footer__grid {
            grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
            gap: var(--space-8);
        }
    }
    .footer a {
        color: inherit;
    }
    .footer__name {
        font-family: var(--font-display);
        font-size: var(--step-3);
        margin: 0 0 var(--space-2);
        font-variation-settings:
            'opsz' 48,
            'WONK' 1;
    }
    .footer__version {
        color: var(--amber-soft);
        font-family: var(--font-mono);
        font-size: var(--step--1);
        margin-left: 0.4em;
    }
    .footer__tag {
        font-family: var(--font-display);
        font-style: italic;
    }
    .footer__links {
        list-style: none;
        padding: 0;
        margin: var(--space-4) 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        font-size: var(--step--1);
    }
    .footer__credits {
        font-size: var(--step--1);
    }
    /* Folded by default so the two columns sit at one height; the title is the
       handle, with the pen's own caret beside it. */
    .footer__credits-title {
        font-family: var(--font-display);
        font-size: var(--step-1);
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
    }
    .footer__credits-title::-webkit-details-marker {
        display: none;
    }
    .footer__credits-title::after {
        content: '+';
        font-family: var(--font-mono);
        font-size: var(--step--1);
        color: var(--amber-soft);
        transition: transform 160ms ease;
    }
    .footer__credits[open] .footer__credits-title {
        margin-bottom: var(--space-3);
    }
    .footer__credits[open] .footer__credits-title::after {
        transform: rotate(45deg);
    }
    .footer__credits-title:focus-visible {
        outline: 2px solid var(--amber-soft);
        outline-offset: 4px;
    }
    .footer__credits ul {
        list-style: none;
        padding: 0;
        margin: 0 0 var(--space-4);
        display: grid;
        gap: var(--space-2);
    }
    .footer__family {
        margin-top: var(--space-5);
        font-size: var(--step--1);
    }
    .footer__family-title {
        font-family: var(--font-type);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--amber-soft);
        margin: 0 0 var(--space-2);
    }
    .footer__family ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .footer__family span {
        color: var(--amber-soft);
    }
    .footer__licence {
        color: var(--amber-soft);
    }
    .footer__note {
        color: var(--amber-soft);
        max-width: 56ch;
    }
</style>
