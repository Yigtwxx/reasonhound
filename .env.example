# Reasonhound reads your model API key from the environment (BYOK).
# Copy this file to `.env` and fill in ONLY the provider you use.
# The real `.env` is git-ignored — never commit your keys.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Ollama runs locally and needs no key. OLLAMA_HOST is a host, not a secret;
# set it only if the daemon is not on the default address.
# OLLAMA_HOST=http://localhost:11434
